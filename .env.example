# העתק קובץ זה ל-.env ומלא את הערכים (הקובץ .env מוחרג מ-git).
# ב-Render מגדירים את אותם משתנים ב-Environment בלוח הבקרה.

# טוקן הבוט מ-BotFather
TELEGRAM_TOKEN=

# פרטי ההתחברות ל-Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# שם המבצע/הקו הנוכחי - מופיע בכותרות הדוחות והתזכורות
DEPLOYMENT_NAME=שאגת הארי

# PORT מוגדר אוטומטית על ידי Render - אין צורך למלא מקומית
# PORT=3000

# הבוט דטרמיניסטי לחלוטין - אין צורך במפתח LLM (לא Gemini ולא Claude).

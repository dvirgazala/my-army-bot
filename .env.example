# העתק קובץ זה ל-.env ומלא את הערכים (הקובץ .env מוחרג מ-git).
# ב-Render מגדירים את אותם משתנים ב-Environment בלוח הבקרה.

# טוקן הבוט מ-BotFather
TELEGRAM_TOKEN=

# פרטי ההתחברות ל-Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# שם המבצע/הקו הנוכחי - מופיע בכותרות הדוחות והתזכורות
DEPLOYMENT_NAME=שאגת הארי

# PORT מוגדר אוטומטית על ידי Render - אין צורך למלא מקומית
# PORT=3000

# --- AI fallback (אופציונלי) ---
# הבוט מבין את הפקודות בעצמו (דטרמיניסטי). ה-LLM רץ רק כשהוא לא מצליח לפענח,
# ומשמש להבנת ניסוחים חופשיים ומיפוי כינויים/שגיאות כתיב לשמות מהמצבת.
# אם שני המפתחות ריקים - הבוט עדיין עובד, רק בלי ה-fallback החכם.
# Claude עדיף אם מוגדר; אחרת ישתמש ב-Gemini.
ANTHROPIC_API_KEY=
GEMINI_KEY=
